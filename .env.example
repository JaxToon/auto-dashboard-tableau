# Proactive Business Analytics Copilot - environment template (placeholders only).
# Copy to .env at the repo root. Never commit real secrets; inject them from an approved secret manager.

APP_ENV=local
APP_MODE=synthetic
APP_BASE_URL=http://localhost:3000
# PostgreSQL via docker-compose or an approved platform:
# Default (unset): SQLite at <repo>/var/app.db for the isolated local prototype.
# DATABASE_URL=sqlite:///D:/path/to/var/app.db
# DATABASE_URL=postgresql+psycopg://pbac:pbac@localhost:5432/proactive_analytics

# Mock login is for isolated local development only. A pilot must use the bank's approved SSO.
AUTH_MODE=mock

# Planner. "mock" = deterministic rules-based planner (no external AI calls).
LLM_PROVIDER=mock
LLM_MODEL=mock-dashboard-planner
LLM_BASE_URL=
LLM_API_KEY=

# Tableau. TABLEAU_MODE=rest uses the real REST API (Tableau Server Client).
# TABLEAU_MODE=mock is for development only: it never marks anything Published and returns no URL.
TABLEAU_ENABLED=false
TABLEAU_MODE=rest
TABLEAU_SERVER_URL=
TABLEAU_SITE_CONTENT_URL=
TABLEAU_PROJECT_ID=
TABLEAU_ALLOWED_PROJECT_IDS=
TABLEAU_AUTH_METHOD=pat
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
TABLEAU_VERIFY_SSL=true

# Feature flags / kill switches (env values are ceilings; admins can only switch features off at runtime).
FEATURE_AI_PLANNING=true
FEATURE_DATA_ACCESS=true
FEATURE_DASHBOARD_PUBLISH=false
FEATURE_RECURRING_RECOMMENDATIONS=true
FEATURE_RECOMMENDATION_TELEMETRY=true
FEATURE_CONVERSATIONAL_ANALYTICS_INTEGRATION=false
REVIEW_REQUIRED=true

# Salt for pseudonymous telemetry groups. Empty = random per process (groups do not persist).
TELEMETRY_ACTOR_SALT=
SEED_SIMULATED_EVENTS=true

# Demo thresholds (test parameters, not bank policy)
REC_MIN_EVENTS=10
REC_WINDOW_DAYS=30
REC_MIN_ACTORS=3

AUDIT_LOG_LEVEL=metadata
CORS_ORIGINS=http://localhost:3000
