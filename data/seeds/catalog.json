        "target_achievement_pct"
      ],
      "owner": "Business Analytics (PoC placeholder - to be confirmed)",
      "version": "1.0.0",
      "effective_date": "2026-11-01",
      "status": "approved_for_poc"
    },
    {
      "id": "outstanding_growth_pct",
      "dataset_id": "demo_sme_credit",
      "name": "Outstanding Growth (%)",
      "definition": "Percentage change in period-end outstanding versus the previous period.",
      "formula": {
        "type": "growth",
        "field": "outstanding_amount"
      },
      "formula_display": "(Outstanding[period] / Outstanding[previous period] - 1) x 100",
      "calculation_notes": "Grouped by time: versus the previous period. Without a time dimension: last month of the range versus the month immediately before the range starts. Undefined (blank) when the previous value is missing or zero.",
      "unit": "%",
      "format": "percent",
      "grain": "month",
      "allowed_dimensions": [
        "report_month",
        "region",
        "branch_code",
        "product_segment"
      ],
      "null_handling": "Blank when the comparison base is missing or zero; reported as a warning.",
      "comparison_rules": "Period-over-period on period-end balances.",
