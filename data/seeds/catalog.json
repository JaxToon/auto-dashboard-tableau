  "metrics": [
    {
      "id": "total_outstanding",
      "dataset_id": "demo_sme_credit",
      "name": "Total Credit Outstanding",
      "definition": "Sum of synthetic SME outstanding credit balance at period end.",
      "formula": {
        "type": "sum",
        "field": "outstanding_amount"
      },
      "formula_display": "SUM(outstanding_amount) at the last month of each period",
      "calculation_notes": "Balance (stock) metric: never summed across months. A period or range takes the value of its last available month.",
      "unit": "IDR",
      "format": "currency",
      "grain": "month",
      "allowed_dimensions": [
        "report_month",
        "region",
        "branch_code",
        "product_segment"
      ],
      "null_handling": "Null amounts are excluded and reported as a warning.",
      "comparison_rules": "Compare period-end balances only.",
      "synonyms": [
        "outstanding",
        "kredit outstanding",
        "credit outstanding",
        "baki debet",
        "saldo kredit",
        "posisi kredit",
        "portfolio",
        "portofolio"
      ],
      "related_metrics": [
